#!/usr/bin/env bash
# Health command for a HUTCH pool class (config set-class HUTCH --pool-health <this file>).
# Before every grant and at every release: first the Hutch env status (hutch env status --json). Anything but
# progressStatus READY with codespaceState Available and no deletion request fails the check: a failed rebuild,
# a rebuild in progress, a stopped or deleting env. Then, over ssh to the env $MOP_RESOURCE: read free disk on /
# and available memory.
# The last stdout line is the result for moplib.health_run, which compares it with the pool's
# minFreeGiB and minMemGiB:
#   {"freeGiB": N, "memAvailGiB": M, "sshAlias": A, "uptimeS": S}   exit 0: the facts
#   {"failed": "<reason>"}     exit 3: the env is not READY, is gone, or a check on the VM failed (mark it failed)
#   anything else (hutch env status or ssh failed, no alias, a timeout): unreachable (marked failed and kept)
# It changes nothing on the VM.
set -uo pipefail
hutch="${HUTCH_BIN:-$HOME/.local/bin/hutch-latest}"
status=$("$hutch" env status "$MOP_RESOURCE" --json 2>&1) || {
	case "$status" in  # the env is gone: failed, so the pool drops it; any other error is unreachable
		*"No environment matched"*) printf '{"failed": "hutch has no env %s"}\n' "$MOP_RESOURCE"; exit 3 ;;
	esac
	echo "hutch env status $MOP_RESOURCE failed: $(printf '%s' "$status" | tr '\n' ' ' | tail -c 300)" >&2
	exit 1
}
verdict=$(printf '%s' "$status" | python3 -I -c '
import json,sys
try: e=json.load(sys.stdin)["environment"]
except (ValueError,KeyError,TypeError): print("unknown"); sys.exit()
p,s=e.get("progressStatus"),e.get("codespaceState")
if p=="READY" and s=="Available" and not e.get("deletionRequestedAt"): print("ok")
else: print(json.dumps({"failed":"hutch status %s, %s%s: %s" % (p,s," deletion requested" if e.get("deletionRequestedAt") else "",
    (e.get("progressMessage") or "")[:150])}))
')
case "$verdict" in
	ok) ;;
	unknown) echo "hutch env status $MOP_RESOURCE printed no environment: $(printf '%s' "$status" | tail -c 300)" >&2; exit 1 ;;
	*) printf '%s\n' "$verdict"; exit 3 ;;
esac
alias=$("$hutch" env ssh-config "$MOP_RESOURCE" 2>/dev/null | tail -n 1) || alias=""
if [ -z "$alias" ]; then
	echo "no ssh alias for $MOP_RESOURCE (hutch env ssh-config failed)" >&2
	exit 1
fi
exec ssh -o BatchMode=yes -o ConnectTimeout=30 -o ServerAliveInterval=30 -o ServerAliveCountMax=4 \
	"$alias" "ALIAS='$alias' bash -s" <<'REMOTE'
set -uo pipefail
fail() {
	reason=$(printf '%s' "$1" | tr '\n\t' '  ' | sed 's/\\/\\\\/g; s/"/\\"/g')  # one JSON string
	printf '{"failed": "%s"}\n' "$reason"
	exit 3
}
free=$(df -BG --output=avail / | tail -n 1 | tr -dc '0-9')
[ -n "$free" ] || fail "cannot read free disk on /"
mem=$(awk '/^MemAvailable:/ {printf "%.1f", $2 / 1048576}' /proc/meminfo)
[ -n "$mem" ] || fail "cannot read MemAvailable from /proc/meminfo"
up=$(cut -d. -f1 /proc/uptime 2>/dev/null) || up=""
printf '{"freeGiB": %s, "memAvailGiB": %s, "sshAlias": "%s"%s}\n' "$free" "$mem" "$ALIAS" "${up:+, \"uptimeS\": $up}"
REMOTE
