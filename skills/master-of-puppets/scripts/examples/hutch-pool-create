#!/usr/bin/env bash
# Create command for a HUTCH pool class (config set-class HUTCH --pool-create <this file>).
# Create a Hutch env on main and print {"name": <env id>, "slotType": ..., "branch": "main"}.
# MOP_PREFER_SLOTTYPE (native|emulated|shared|ngrok) picks the slot type; default emulated.
# Hutch picks the zone; the hutch CLI has no zone flag. A failed create copies Hutch's own output to
# stderr, so the refusal names the reason (for example no capacity in the zone).
set -uo pipefail
slot="${MOP_PREFER_SLOTTYPE:-emulated}"
case "$slot" in native|emulated|shared|ngrok) ;; *) echo "bad slot type: $slot" >&2; exit 2 ;; esac
out=$("${HUTCH_BIN:-$HOME/.local/bin/hutch-latest}" env create --branch main --slot-type "$slot" --wait --json 2>&1)
code=$?
if [ "$code" -ne 0 ]; then
	printf 'hutch env create exit %s: %s\n' "$code" "$(printf '%s' "$out" | tail -c 600)" >&2
	exit 1
fi
printf '%s' "$out" | SLOT="$slot" python3 -c '
import json,os,re,sys
u=re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")
def find(o):
    if isinstance(o,dict):
        v=o.get("id")
        if isinstance(v,str) and u.match(v): return v
        for x in o.values():
            r=find(x)
            if r: return r
    if isinstance(o,list):
        for x in o:
            r=find(x)
            if r: return r
raw=sys.stdin.read(); dec=json.JSONDecoder(); pos=0; i=None
while pos<len(raw) and not i:
    while pos<len(raw) and raw[pos].isspace(): pos+=1
    if pos>=len(raw): break
    try: obj,pos=dec.raw_decode(raw,pos)
    except ValueError: pos=raw.find("\n",pos)+1 or len(raw); continue
    i=find(obj)
if not i: sys.exit("no env id in create output: "+raw[-400:])
print(json.dumps({"name":i,"slotType":os.environ["SLOT"],"branch":"main"}))
'
